OPENAI_API_KEY=sk-你的key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-pro

# ── 可选：成本估算单价覆盖（元/百万 tokens，默认值见 observability.py 的 PRICE_TABLE）──
# LLM_PRICE_CACHE_HIT=0.025
# LLM_PRICE_CACHE_MISS=3.0
# LLM_PRICE_OUTPUT=6.0

# ── 可选：接入 LangSmith 云端追踪（本地追踪无需任何配置，加 --trace 即可）──
# 注意：开启后追踪数据会上传到 LangSmith 云端（数据离开本机），且 LangSmith 在境外需代理
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_你的key
# LANGSMITH_PROJECT=labour-agent
# HTTPS_PROXY=http://127.0.0.1:7893
